# ==============================================================================
# FESTIVALMINT AI — Environment Configuration Template
# Copy this file to `.env.local` and fill in your credentials.
# NEVER commit `.env.local` or real secrets to version control.
# ==============================================================================

# --- Supabase (Database, Auth, Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only secret! Never expose in client components or NEXT_PUBLIC_* vars.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- AI Provider (Choose gemini or openai; server-only) ---
AI_PROVIDER=gemini
# You may set AI_API_KEY directly (defaults to Gemini), or provider-specific keys below:
AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- PayPal Sandbox (@paypal/paypal-server-sdk Orders v2 + JS SDK) ---
PAYPAL_ENV=sandbox
# Client ID may also be read via NEXT_PUBLIC_PAYPAL_CLIENT_ID for browser PayPal Buttons
PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Server-only secrets! Never expose in client bundle.
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Application URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Demo Seed Script (Optional, used only by server-side seed script) ---
DEMO_SEED_PASSWORD=DemoMint!2026

